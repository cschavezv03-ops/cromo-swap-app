{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "exactOptionalPropertyTypes": false,
    "types": [
      "@types/jest"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "src",
    "__tests__",
    "**/*.tsx",
    "**/*.ts",
    "nativewind-env.d.ts"
  ]
}